{
  "name": "spotify-calendar",
  "short_name": "spotify-cal",
  "description": "Browse your saved Spotify albums on a warm, editorial calendar — grouped by the day you added each one, filtered by year, artist and genre.",
  "id": "/",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#efe9dd",
  "theme_color": "#b0532f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "lifestyle", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
