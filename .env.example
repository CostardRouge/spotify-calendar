# =============================================================================
# Spotify Library Calendar — environment configuration
# Copy this file to ".env" (make init does it for you) and fill in the values.
# =============================================================================

# --- Spotify app credentials -------------------------------------------------
# Create a free app at https://developer.spotify.com/dashboard
# and copy its Client ID / Client Secret here.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# --- OAuth redirect URI ------------------------------------------------------
# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
#   Local dev:  http://127.0.0.1:3000/api/auth/callback
#   Home Lab:   http://<optiplex-ip-or-host>:3000/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# --- Sésame in front (optional) ----------------------------------------------
# The owner's identity provider (OpenID Connect, costardrouge/sesame). Set the
# three and the whole app sits behind « Sign in with Sésame » (proxy.ts) — who
# may use this instance at all is decided there, by membership of the app
# `spotify-calendar`; the Spotify sign-in stays behind it, unchanged. Empty =
# no gate, as before. Sésame's app redirect: <this origin>/api/auth/sesame/callback
# SESAME_ISSUER=https://auth.steeve.website
# SESAME_CLIENT_ID=spotify-calendar
# SESAME_CLIENT_SECRET=

# --- Host port ---------------------------------------------------------------
# Port published on the host (used by the Home Lab compose file). The app
# always listens on 3000 inside the container.
APP_PORT=3000

# --- Public site URL (for share links / PWA) ---------------------------------
# Origin where the app is publicly reachable, for the absolute Open Graph and
# Twitter card image URLs a shared link's preview needs. Usually leave it unset:
# the app then takes the address from each request (X-Forwarded-Host/-Proto
# behind a proxy, else Host). Read at BUILD time — the published Docker image
# is built without it, so it only matters for an image you build yourself.
#   e.g. https://calendar.example.com   or   http://<optiplex-ip-or-host>:3000
# NEXT_PUBLIC_SITE_URL=https://calendar.example.com

# --- Data folder -------------------------------------------------------------
# Where the server keeps its files: each account's library copy lives in its
# library/ subfolder (see LIBRARY_DIR below). Defaults to the OS temp dir. In
# the Home Lab compose this is /app/.cache, backed by a named volume so the
# libraries survive container restarts.
# CACHE_DIR=/app/.cache

# --- Debugging ---------------------------------------------------------------
# SYNC_DEBUG=1 prints every Spotify call with its timing and, on each token
# refresh, the granted scope string to the server console (the scope-drift
# investigation of docs/memory/architecture.md). Off by default: leave it
# unset in production, set it for one investigation, then unset it again.
# SYNC_DEBUG=1

# --- Per-user library store --------------------------------------------------
# Each Spotify account's completed sync is mirrored server-side in its own
# file, so multiple users can share one deployment without ever overwriting
# each other's library. Defaults to <CACHE_DIR>/library when CACHE_DIR is set
# (persisted by the Home Lab volume), otherwise the OS temp dir.
# LIBRARY_DIR=/app/.cache/library
